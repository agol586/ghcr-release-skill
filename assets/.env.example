IMAGE=ghcr.io/your-org/your-repo-app1
VERSION=v1.2.3
BIND_IP=127.0.0.1
HOST_PORT=8080
APP_PORT=8080
TZ=Asia/Shanghai
# The application must support these names, or replace them with its own settings.
CONFIG_FILE=/app/config/config.yml
LOG_DIR=/app/logs
# Configure the app's logger for text stdout/stderr; this name must be supported.
LOG_FORMAT=text
DATA_DIR=/app/data
# DNS_SERVER=10.0.0.2
# DATABASE_URL=postgresql://user:password@your-rds-endpoint:5432/app?sslmode=require
# OTHER_SERVICE_URL=http://host.docker.internal:9000
